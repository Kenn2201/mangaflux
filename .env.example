# Browser-visible configuration. This URL is public by design.
# Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Vercel / Next server-only upstream URL.
MANGAFLUX_API_URL=http://localhost:4000

# Shared server-to-server auth proxy secret.
# Use the SAME random value for:
# - Render: AUTH_PROXY_SECRET
# - Vercel: MANGAFLUX_AUTH_PROXY_SECRET
AUTH_PROXY_SECRET=
MANGAFLUX_AUTH_PROXY_SECRET=

# Render / API
PORT=4000
WEB_ORIGIN=http://localhost:3000
MANGADEX_BASE_URL=https://api.mangadex.org
APP_ORIGIN=http://localhost:3000

# Render / API only.
DATABASE_URL=

# Resend transactional email (Render / API only).
# Never expose RESEND_API_KEY through NEXT_PUBLIC_*.
RESEND_API_KEY=
EMAIL_FROM=MangaFlux <noreply@manga.kenncode.me>
